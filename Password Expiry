$user = Get-ADUser username -Properties PasswordLastSet
$policy = Get-ADDefaultDomainPasswordPolicy

[PSCustomObject]@{
    User               = $user.SamAccountName
    PasswordLastSet    = $user.PasswordLastSet
    PasswordDuration   = $policy.MaxPasswordAge.Days
    PasswordExpiresOn  = $user.PasswordLastSet + $policy.MaxPasswordAge
}

##username replace with user i.e JoeBloggs
