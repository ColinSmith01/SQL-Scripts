-- Switch to the target database where you want to check permissions
USE [YourDatabaseName];
GO

-- Select relevant permission details for specific database users
SELECT 
    dp.name AS principal_name,              -- The name of the database principal (user or role)
    dp.type_desc AS principal_type,         -- The type of principal (e.g., SQL user, Windows user, role)
    o.name AS object_name,                  -- The name of the object the permission applies to (e.g., table, view)
    p.permission_name,                      -- The specific permission granted (e.g., SELECT, EXECUTE)
    p.state_desc AS permission_state        -- The state of the permission (GRANT, DENY, REVOKE)
FROM sys.database_permissions p             -- Permissions granted at the database level
JOIN sys.database_principals dp             -- Database users and roles
    ON p.grantee_principal_id = dp.principal_id
LEFT JOIN sys.objects o                     -- Database objects (tables, views, etc.)
    ON p.major_id = o.object_id
WHERE dp.name IN ('Login1', 'Login2');      -- Filter for the specific logins you're interested in
