-- When index optimising fails you can use this to check and search for any errornumbers / error messages

SELECT 
    DatabaseName,
    SchemaName,
    ObjectName,
    ObjectType,
    IndexName,
    IndexType,
    Command,
    CommandType,
    StartTime,
    EndTime,
    ErrorNumber,
    ErrorMessage
FROM [DBA].[dbo].[CommandLog]
WHERE StartTime >= '2025-07-21 00:00:00'
ORDER BY StartTime DESC;
